# Copy to .env (cp env.example .env) and adjust. Matches docker-compose.yml defaults.
# If port 3306 is already taken on your machine, start MySQL with a different
# host port (`MYSQL_PORT=3307 docker compose up -d mysql`) and update the URL.
DATABASE_URL="mysql://root:agentdock@localhost:3306/agentdock"

# Control Server listen port. Aligned with the NATAPP tunnel target (3100).
PORT=3100

# Public HTTPS base URL (NATAPP tunnel -> http://127.0.0.1:3100).
# Used for GitHub webhook registration and callback / deep links.
PUBLIC_BASE_URL="https://baolf.nat100.top"

# Single-user static token for MVP (confirmed decision: no users table).
# The Web client and Runner authenticate with tokens; generate strong values:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Startup validation rejects placeholders, anything shorter than 16 characters,
# and reuse of the same value for both tokens (a runner token must be
# revocable on its own). Every non-health endpoint is gated by these tokens.
API_AUTH_TOKEN="change-me-web-token"
RUNNER_TOKEN="change-me-runner-token"

# Optional comma-separated CORS allowlist for the Web console.
# Unset means "reflect the request origin" (development default).
CORS_ORIGIN=""

# GitHub integration.
# Webhook URL to register on GitHub: ${PUBLIC_BASE_URL}/github/webhook
# The webhook route verifies X-Hub-Signature-256 against this secret and
# dedupes by X-GitHub-Delivery before creating a task (#29).
# GITHUB_APP_ID / GITHUB_PRIVATE_KEY additionally enable GitHub App
# authentication and repository <-> project binding (Milestone 6, #28:
# GET /github/installations, POST/GET/DELETE /projects/:projectId/repositories).
GITHUB_WEBHOOK_SECRET=""
GITHUB_APP_ID=""
GITHUB_PRIVATE_KEY=""

# Optional comma-separated allowlist of GitHub logins allowed to trigger tasks
# via @agent mentions (requirements.md §6.2). Empty/unset allows any non-bot
# actor — fine for a single-user MVP, tighten this on a shared repository.
GITHUB_ACTOR_ALLOWLIST=""
