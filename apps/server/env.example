# Copy to .env (cp env.example .env) and adjust. Matches docker-compose.yml defaults.
DATABASE_URL="mysql://root:agentdock@localhost:3306/agentdock"

# Control Server listen port. Aligned with the NATAPP tunnel target (3100).
PORT=3100

# Public HTTPS base URL (NATAPP tunnel -> http://127.0.0.1:3100).
# Used for GitHub webhook registration and callback / deep links.
PUBLIC_BASE_URL="https://baolf.nat100.top"

# Single-user static token for MVP (confirmed decision: no users table).
# The Web client and Runner authenticate with tokens; generate strong values.
# IMPORTANT: the server is publicly reachable through the tunnel, so every
# non-health endpoint MUST be gated by these tokens before it is added.
API_AUTH_TOKEN="change-me-web-token"
RUNNER_TOKEN="change-me-runner-token"

# GitHub integration — Milestone 6.
# Webhook URL to register on GitHub: ${PUBLIC_BASE_URL}/github/webhook
GITHUB_WEBHOOK_SECRET=""
GITHUB_APP_ID=""
GITHUB_PRIVATE_KEY=""
